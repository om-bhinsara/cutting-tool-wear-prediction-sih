# PostgreSQL
DATABASE_URL=postgresql://postgres:YOUR_POSTGRES_PASSWORD@localhost:5432/toolwear_db

# Flask
FLASK_ENV=development
FLASK_DEBUG=1

# API
API_HOST=0.0.0.0
API_PORT=5000

# JWT
JWT_SECRET=your-jwt-secret-key

# Email verification API
EMAIL_VERIFY_API_KEY=your-email-verification-api-key

# SMTP / Gmail
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=your-gmail@gmail.com
SMTP_PASSWORD=your-gmail-app-password
